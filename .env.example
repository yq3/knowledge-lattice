# knowledge-lattice 环境变量模板（.env 不入库——本文件为入库模板，P3-11）
# 覆盖语义：LATTICE_* 环境变量仅开发/测试；生产配置级切换（design §3）。
# 复制为 .env 后按需启用（cp .env.example .env）。

# ---- 嵌入网关（OpenAI 兼容；百炼接入 = 覆盖 base + key，M0b-3 P3-11）----
# LATTICE_EMBED_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# LATTICE_EMBED_API_KEY=sk-xxxxxxxxxxxxxxxx

# ---- PostgreSQL 后端（D24 可选后端；sqlite 默认无需设置）----
# 容器：docker start lattice-pg
# LATTICE_PG_DSN=postgresql://postgres:lattice@localhost:5432/lattice
#                                      # PG 后端 DSN（D24）——**当前 app/worker
#                                      # 默认恒 sqlite（store/factory.build_backend）；
#                                      # PG 后端的 app 侧完整接线归后续段**（P3-N9
#                                      # 注记）。测试门禁经本 DSN 跑 pg 臂参数化用例

# ---- 以下是 config.py 支持的其余覆盖项（默认值见 Settings）----
# LATTICE_ENV=dev                      # dev | test | prod
# LATTICE_DATA_DIR=data
# LATTICE_EMBED_TIMEOUT_S=30.0
# LATTICE_PROBE_WARN=0.99              # 指纹探针告警阈值（G-8，M1 校准）
# LATTICE_PROBE_REJECT=0.95            # 拒绝写入阈值
# LATTICE_PROBE_INTERVAL_S=600.0
# LATTICE_DEV_JWT_SECRET=change-me     # 仅 dev/test 签发（生产另配，D18）
# LATTICE_MCP_TIMEOUT_S=60.0
# LATTICE_LOG_LEVEL=INFO
# LATTICE_LOG_FORMAT=json              # json | human

# ---- 上传凭证（M1-3 三步式）----
# LATTICE_UPLOAD_TTL_S=900.0            # 凭证有效期（签发 → expires_at，默认 15min）
# LATTICE_UPLOAD_MAX_BYTES=209715200    # PUT 全局上限（默认 200MB——413 独立生效）
# LATTICE_MAINTENANCE_INTERVAL_S=300.0  # maintenance 调度周期（0=关闭；staging 清扫
#                                       #   阈值 = max(TTL, 2×interval)）

# ---- worker 任务框架（M2.1——心跳/租约/重试/取消 + maintenance 任务族）----
# LATTICE_WORKER_MODE=subprocess           # subprocess=worker 子进程隔离（默认——
#                                          #   §2 部署形态，OOM 只杀子进程+自动拉起）
#                                          #   | inline=进程内 TaskRunner（测试/最小
#                                          #   部署——同一执行体，无进程隔离）
# LATTICE_WORKER_HEARTBEAT_S=5.0           # running 任务心跳周期（heartbeat_at 刷新）
# LATTICE_WORKER_LEASE_S=60.0              # 租约时长（过期可被重认领——杀 worker 不丢任务）
# LATTICE_WORKER_POLL_S=5.0                # 兜底轮询周期（IPC 唤醒之外的第二通道）
# LATTICE_WORKER_STARTUP_PROBE=1           # worker 子进程启动指纹探针（写入侧 gate）
# LATTICE_WORKER_RESTART_BACKOFF_S=1.0     # 子进程死亡后自动拉起退避（秒）
# LATTICE_TASK_MAX_ATTEMPTS=3              # 重试上限（attempts ≥ 3 转 failed 留人工）
# LATTICE_MAINTENANCE_KEEP_DAYS=7          # maintenance done/failed 任务行保留天数
# LATTICE_MAINTENANCE_KEEP_COUNT=500       # maintenance done/failed 任务行保留条数上限
# LATTICE_TOMBSTONE_KEEP_DAYS=90           # tombstone 块物理清理窗口（天）
# LATTICE_EMBED_DIM=2560                   # 嵌入维度（worker 子进程经 env 同步——
#                                          #   程序化 Settings 的其余字段以 env 为准）

# ---- 审计月库 + 备份（M2.4 m2-2——TC-OPS-02/05）----
# LATTICE_AUDIT_KEEP_MONTHS=12             # 审计月库保留期（月——13 个月前整文件/
#                                          #   分区删除，FR-6）
# LATTICE_BACKUP_INTERVAL_S=86400.0        # 备份快照最小间隔（秒；RPO ≤24h 口径；
#                                          #   0=每轮 maintenance 都快照——测试）
# LATTICE_PG_DUMP_CMD="docker exec lattice-pg pg_dump"    # pg 臂备份工具（容器形态；
#                                          #   缺省找 PATH 的 pg_dump，都无则快照
#                                          #   状态 unavailable——部署 runbook 配置）
# LATTICE_PG_RESTORE_CMD="docker exec -i lattice-pg pg_restore"  # 恢复演练同款

# ---- 语义层同步（M2-S1——design §5.8；D23 语义轨道首段）----
# per-org 源系统连接（JSON：{org: {adapter: {endpoint, api_key, timeout_s}}}——
# #37 前置条件③：部署时配置、重启生效；未配置 org/适配器 → 配置错误不静默跳过；
# m2s-3 起五源齐：template_center / metadata / scenario_config / report_center /
# yaml——yaml 源 endpoint=本地 checkout 目录、webhook_secret=Git 回调签名密钥
# 〔X-Lattice-Signature: sha256=HMAC-SHA256(body)——凭证明文不落日志〕）
# LATTICE_SEM_SOURCES_JSON={"org:tax": {"template_center": {"endpoint": "http://tc.internal/api", "api_key": "sk-xxx", "timeout_s": 30.0}, "metadata": {"endpoint": "http://md.internal/api"}, "scenario_config": {"endpoint": "http://sc.internal/api"}, "report_center": {"endpoint": "http://rc.internal/api"}, "yaml": {"endpoint": "/srv/semantic-yaml-checkout", "webhook_secret": "whsec-CHANGE-ME"}}}
# LATTICE_SEM_DELETE_GUARD=0.2            # 删除比例保护阈值（快照相对库内该来源
#                                          #   active 实体消失比例 > 阈值 → aborted_guard
#                                          #   零写入——T-S2）
# LATTICE_SEM_GRACE_DAYS=7                # missing 宽限期（天）——超期转 retired 且
#                                          #   关系一并 retired（T-S4）
# LATTICE_SEM_BATCH_ROWS=1000             # 同步分批行数上限（每批单事务提交——
#                                          #   NFR-11 写锁治理）
# LATTICE_SEM_DIM_ALERT_BASELINE=0.8      # 维度填充率骤降告警：库内基线 ≥ 此值才
#                                          #   参与判定（TC-SYNC-06② 对冲项）
# LATTICE_SEM_DIM_ALERT_DROP=0.5          # 快照携带率 < 基线×此值 → 告警
# LATTICE_SEM_NIGHT_WINDOW=               # 错峰窗口登记（如 "01:00-05:00"——本段不
#                                          #   强制生效；分批即天然限速）
# LATTICE_SEM_L0_TOKEN_BUDGET=1500        # L0 总 token 预算（§5.8 l0 行——YAML CI
#                                          #   拦截阈值：scripts/sem_yaml_ci.py 同源
#                                          #   读取；m2s-3 R2 接线）
