# knowledge-lattice 环境变量模板（.env 不入库——本文件为入库模板，P3-11）
# 覆盖语义：LATTICE_* 环境变量仅开发/测试；生产配置级切换（design §3）。
# 复制为 .env 后按需启用（cp .env.example .env）。

# ---- 嵌入网关（OpenAI 兼容；百炼接入 = 覆盖 base + key，M0b-3 P3-11）----
# LATTICE_EMBED_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# LATTICE_EMBED_API_KEY=sk-xxxxxxxxxxxxxxxx

# ---- PostgreSQL 后端（D24 可选后端；sqlite 默认无需设置）----
# 容器：docker start lattice-pg
# LATTICE_PG_DSN=postgresql://postgres:lattice@localhost:5432/lattice

# ---- 以下是 config.py 支持的其余覆盖项（默认值见 Settings）----
# LATTICE_ENV=dev                      # dev | test | prod
# LATTICE_DATA_DIR=data
# LATTICE_EMBED_TIMEOUT_S=30.0
# LATTICE_PROBE_WARN=0.99              # 指纹探针告警阈值（G-8，M1 校准）
# LATTICE_PROBE_REJECT=0.95            # 拒绝写入阈值
# LATTICE_PROBE_INTERVAL_S=600.0
# LATTICE_DEV_JWT_SECRET=change-me     # 仅 dev/test 签发（生产另配，D18）
# LATTICE_MCP_TIMEOUT_S=60.0
# LATTICE_LOG_LEVEL=INFO
# LATTICE_LOG_FORMAT=json              # json | human
